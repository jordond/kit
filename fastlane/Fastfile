# frozen_string_literal: true

require "fileutils"
require "tmpdir"

# kit's shared Fastfile. Every app imports it with one line:
#
#   import(ENV.fetch("KIT_FASTFILE") { UI.user_error!("Run fastlane via `kit fastlane ...` or `kit release ...`") })
#
# and kit runs fastlane with BUNDLE_GEMFILE pointing at the Gemfile next to this
# file. Lanes take every input from env vars and report results as `KIT_*=`
# lines on stdout; kit reads only those lines (PLAN §9.4).
#
# Conventions:
# - Values kit computes or materialises use KIT_* names. Secrets keep their
#   canonical names (ASC_KEY_ID, ASC_ISSUER_ID, MATCH_PASSWORD, MATCH_GIT_URL,
#   MATCH_GIT_BASIC_AUTHORIZATION, SENTRY_AUTH_TOKEN; PLAN §9.5). Secret files
#   arrive as paths (KIT_ASC_KEY_PATH, KIT_PLAY_JSON_KEY), never as contents.
# - Paths should be absolute. A relative path is resolved against KIT_APP_ROOT,
#   else the directory holding the app's fastlane/ folder. Never against
#   __dir__: that is kit's package directory, not the app.
# - fastlane runs lanes with the working directory set to <app>/fastlane.
# - Helpers are kit_-prefixed methods and there are no top-level constants, so
#   an app Fastfile can define its own without clashing.
# - Lane names avoid fastlane action names (`testflight`, `appstore`, `cert`):
#   a lane that shadows an action makes every later call to it ambiguous.

# ---------------------------------------------------------------- helpers ---

def kit_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("#{name} is not set (kit passes it; run fastlane via kit)") if value.empty?
  value
end

def kit_env_opt(name, default = nil)
  value = ENV[name].to_s.strip
  value.empty? ? default : value
end

def kit_flag?(name, default: false)
  value = ENV[name].to_s.strip
  return default if value.empty?

  %w[1 true yes].include?(value.downcase)
end

def kit_list(name)
  ENV[name].to_s.split(",").map(&:strip).reject(&:empty?)
end

def kit_app_root
  kit_env_opt("KIT_APP_ROOT") ||
    File.expand_path("..", FastlaneCore::FastlaneFolder.path || Dir.pwd)
end

def kit_path(name, required: true)
  raw = required ? kit_env(name) : kit_env_opt(name)
  raw && File.expand_path(raw, kit_app_root)
end

# The output protocol. kit parses `KIT_<KEY>=<value>` lines from stdout only.
def kit_emit(key, value)
  $stdout.puts("KIT_#{key}=#{value}")
  $stdout.flush
end

def kit_skip_upload?(what, artifact)
  return false unless kit_flag?("KIT_SKIP_UPLOAD")

  UI.important("KIT_SKIP_UPLOAD=1: skipping #{what} of #{artifact}.")
  true
end

def kit_require_file(name)
  path = kit_path(name)
  UI.user_error!("#{name} points at #{path}, which does not exist") unless File.exist?(path)
  path
end

# ------------------------------------------------------------------- iOS ---

# App Store Connect API key (.p8). match, the build-number lookups and every
# upload authenticate with it: no Apple ID, no 2FA. kit decodes
# ASC_KEY_P8_BASE64 to a 0600 temp file and passes its path.
def kit_asc_api_key
  app_store_connect_api_key(
    key_id: kit_env("ASC_KEY_ID"),
    issuer_id: kit_env("ASC_ISSUER_ID"),
    key_filepath: kit_require_file("KIT_ASC_KEY_PATH")
  )
end

# KIT_IOS_BUNDLE_IDS lists every signed target (app first, then extensions).
# KIT_IOS_BUNDLE_ID defaults to the first of them.
def kit_ios_bundle_ids
  ids = kit_list("KIT_IOS_BUNDLE_IDS")
  ids = [kit_env("KIT_IOS_BUNDLE_ID")] if ids.empty?
  ids
end

def kit_ios_bundle_id
  kit_env_opt("KIT_IOS_BUNDLE_ID") || kit_ios_bundle_ids.first
end

def kit_match(readonly:, api_key:)
  params = {
    type: "appstore",
    storage_mode: "git",
    git_url: kit_env("MATCH_GIT_URL"),
    app_identifier: kit_ios_bundle_ids,
    readonly: readonly,
    api_key: api_key
  }
  team = kit_env_opt("KIT_IOS_TEAM_ID")
  params[:team_id] = team if team
  match(params)
end

def kit_ios_ipa
  kit_require_file("KIT_IOS_IPA")
end

# metadata_pull / metadata_push helpers. deliver keeps the App Review contact
# (name, phone, email) and the demo account's user and password as plaintext
# files in <metadata>/review_information. kit never leaves that directory in
# the repo and never uploads it.
def kit_review_information?(entry)
  entry.casecmp?("review_information")
end

def kit_strip_review_information(metadata)
  return false unless File.directory?(metadata)

  found = Dir.children(metadata).select { |entry| kit_review_information?(entry) }
  found.each { |entry| FileUtils.rm_rf(File.join(metadata, entry)) }
  !found.empty?
end

# Copy the metadata directory into `into` for deliver to read, without
# review_information/ and without supply's android/ (deliver skips that one).
def kit_metadata_for_push(metadata, into)
  FileUtils.mkdir_p(into)
  Dir.children(metadata).each do |entry|
    # Any case: on a case-insensitive disk deliver reads Review_Information/ as review_information/.
    next if entry.start_with?(".") || kit_review_information?(entry) || entry.casecmp?("android")

    FileUtils.cp_r(File.join(metadata, entry), into)
  end
  into
end

# The version deliver would edit, or an immediate error: with none, deliver
# sits in its retry loop (7 tries, up to 5 minutes apart) before failing.
def kit_require_editable_version(app, platform, bundle_id)
  version = app.get_edit_app_store_version(platform: platform)
  return version if version

  UI.user_error!(
    "#{bundle_id} has no editable App Store version, so there is no listing to update. " \
    "Create the next version in App Store Connect, or push after `kit release ios --track prod`."
  )
end

platform :ios do
  desc "Print the next build number: max(TestFlight, App Store) + 1."
  desc "In: KIT_IOS_BUNDLE_ID, ASC_KEY_ID, ASC_ISSUER_ID, KIT_ASC_KEY_PATH. Out: KIT_NEXT_BUILD=<n>."
  lane :next_build do
    api_key = kit_asc_api_key
    bundle_id = kit_ios_bundle_id
    tf = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id, initial_build_number: 0)
    rescue StandardError => e
      UI.important("Could not fetch the TestFlight build number: #{e.message}")
      0
    end
    as = begin
      app_store_build_number(api_key: api_key, app_identifier: bundle_id, initial_build_number: 0, live: false)
    rescue StandardError => e
      UI.important("Could not fetch the App Store build number: #{e.message}")
      0
    end
    latest = [tf.to_i, as.to_i].max
    if latest.zero?
      UI.user_error!("No build numbers in TestFlight or the App Store. Upload the first build with `kit release ios --build 1`.")
    end
    UI.message("Latest build numbers: TestFlight #{tf}, App Store #{as}")
    kit_emit("NEXT_BUILD", latest + 1)
  end

  # Signing lives in the Xcode project (Release configuration, manual, match
  # profiles). It must not be forced via xcargs: an xcarg applies to every target
  # xcodebuild builds, including SPM resource bundles, which reject a profile.
  # Version and build are safe as xcargs because the projects are
  # build-settings driven (GENERATE_INFOPLIST_FILE = YES), so the tree stays
  # clean.
  desc "Sync signing with match (readonly), then build a signed App Store .ipa."
  desc "In: KIT_IOS_PROJECT, KIT_IOS_SCHEME, KIT_IOS_BUNDLE_IDS, KIT_IOS_TEAM_ID, KIT_IOS_VERSION, " \
       "KIT_IOS_BUILD, KIT_IOS_OUTPUT (.ipa path), MATCH_*, ASC_*. Out: KIT_ARTIFACT_IPA=, KIT_ARTIFACT_DSYM=."
  lane :build do
    setup_ci if ENV["CI"] == "true"
    api_key = kit_asc_api_key
    kit_match(readonly: true, api_key: api_key)

    output = kit_path("KIT_IOS_OUTPUT")
    ids = kit_ios_bundle_ids
    ipa = build_app(
      project: kit_require_file("KIT_IOS_PROJECT"),
      scheme: kit_env("KIT_IOS_SCHEME"),
      export_method: "app-store",
      clean: true,
      output_directory: File.dirname(output),
      output_name: File.basename(output),
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: ids.to_h { |id| [id, "match AppStore #{id}"] }
      },
      xcargs: [
        "MARKETING_VERSION=#{kit_env('KIT_IOS_VERSION')}",
        "CURRENT_PROJECT_VERSION=#{kit_env('KIT_IOS_BUILD')}"
      ].join(" ")
    )

    # gym zips the archive's dSYMs next to the ipa. Fall back to the archive's
    # dSYMs folder, which sentry-cli also accepts.
    dsym = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    dsym = File.join(archive, "dSYMs") if (dsym.nil? || !File.exist?(dsym)) && archive

    kit_emit("ARTIFACT_IPA", ipa)
    kit_emit("ARTIFACT_DSYM", dsym) if dsym
  end

  desc "Upload a built .ipa to TestFlight."
  desc "In: KIT_IOS_IPA, KIT_IOS_BUNDLE_ID, KIT_TESTFLIGHT_GROUPS (comma list; empty = internal testers only), " \
       "KIT_RELEASE_NOTES, ASC_*, KIT_SKIP_UPLOAD."
  lane :upload_testflight do
    ipa = kit_ios_ipa
    next if kit_skip_upload?("the TestFlight upload", ipa)

    groups = kit_list("KIT_TESTFLIGHT_GROUPS")
    external = !groups.empty?
    params = {
      api_key: kit_asc_api_key,
      app_identifier: kit_ios_bundle_id,
      ipa: ipa,
      distribute_external: external,
      # pilot ignores distribute_external when it skips the wait: it returns as
      # soon as the build appears, before processing ends, so the build never
      # reaches the group. Only internal-only uploads can skip the wait.
      skip_waiting_for_build_processing: !external,
      changelog: kit_env_opt("KIT_RELEASE_NOTES", "")
    }
    params[:groups] = groups if external
    upload_to_testflight(params)
    UI.success("Uploaded to TestFlight (#{external ? "groups: #{groups.join(', ')}" : 'internal testers'}).")
  end

  desc "Upload a built .ipa to the App Store and submit it for review."
  desc "In: KIT_IOS_IPA, KIT_IOS_BUNDLE_ID, KIT_RELEASE_NOTES (What's New, en-US), KIT_APPSTORE_PHASED (default 1), " \
       "KIT_APPSTORE_SUBMIT (default 1), ASC_*, KIT_SKIP_UPLOAD."
  lane :upload_appstore do
    ipa = kit_ios_ipa
    whats_new = kit_env_opt("KIT_RELEASE_NOTES", "")
    next if kit_skip_upload?("the App Store upload", ipa)

    UI.user_error!("KIT_RELEASE_NOTES is empty: App Store Connect will not submit an update without What's New.") if whats_new.empty?

    # deliver defaults metadata_path to <app>/fastlane/metadata, where the
    # repo's store listing can live (`kit metadata pull`): a release must not
    # upload that listing or its stale per-locale release notes. An empty dir
    # loads nothing; the metadata step still runs (see below).
    Dir.mktmpdir("kit-deliver") do |empty|
      upload_to_app_store(
        api_key: kit_asc_api_key,
        app_identifier: kit_ios_bundle_id,
        ipa: ipa,
        submit_for_review: kit_flag?("KIT_APPSTORE_SUBMIT", default: true),
        automatic_release: false, # the operator releases from App Store Connect after approval
        phased_release: kit_flag?("KIT_APPSTORE_PHASED", default: true),
        precheck_include_in_app_purchases: false,
        # No skip_metadata: deliver applies automatic_release and phased_release
        # inside its metadata step, so skipping it silently drops both. What's New
        # is the only listing field this writes.
        release_notes: { "en-US" => whats_new },
        metadata_path: File.join(empty, "metadata"),
        screenshots_path: File.join(empty, "screenshots"),
        skip_screenshots: true,
        force: true # skip the interactive HTML preview
      )
    end
    UI.success("Submitted to the App Store for review.")
  end

  # Without a token, upload nothing rather than fail the release (same as the
  # Sentry Gradle plugin).
  desc "Upload dSYMs to Sentry."
  desc "In: KIT_IOS_DSYM (zip or folder), KIT_SENTRY_ORG, KIT_SENTRY_PROJECT, SENTRY_AUTH_TOKEN, KIT_SKIP_UPLOAD."
  lane :upload_symbols do
    dsym = kit_require_file("KIT_IOS_DSYM")
    next if kit_skip_upload?("the Sentry dSYM upload", dsym)

    token = ENV["SENTRY_AUTH_TOKEN"].to_s
    if token.empty?
      UI.important("SENTRY_AUTH_TOKEN unset: skipped the dSYM upload. Crashes from this build arrive unsymbolicated.")
      next
    end
    sentry_debug_files_upload(
      auth_token: token,
      org_slug: kit_env("KIT_SENTRY_ORG"),
      project_slug: kit_env("KIT_SENTRY_PROJECT"),
      path: dsym
    )
    UI.success("Uploaded dSYMs to Sentry.")
  end

  # Never runs `match nuke` and never regenerates existing certificates. `add`
  # only creates what is missing for this app's bundle ids and team.
  desc "Install (readonly) or add (add) App Store signing for this app via match."
  desc "In: KIT_CERTS_MODE (readonly|add, default readonly), KIT_IOS_BUNDLE_IDS, KIT_IOS_TEAM_ID, MATCH_*, ASC_*."
  lane :certs do
    mode = kit_env_opt("KIT_CERTS_MODE", "readonly")
    UI.user_error!("KIT_CERTS_MODE must be readonly or add, got '#{mode}'") unless %w[readonly add].include?(mode)
    kit_match(readonly: mode == "readonly", api_key: kit_asc_api_key)
  end

  # fastlane has no download action, so this does what `deliver download_metadata`
  # and `deliver download_screenshots` do, with the same deliver classes. Text
  # comes from the latest version; screenshots from the version being edited,
  # else the live one.
  desc "Download the App Store listing text into the app's metadata directory; screenshots too when KIT_METADATA_SCREENSHOTS=1."
  desc "In: KIT_METADATA_PATH, KIT_SCREENSHOTS_PATH, KIT_METADATA_SCREENSHOTS, KIT_IOS_BUNDLE_ID, ASC_*."
  lane :metadata_pull do
    require "deliver"
    require "deliver/setup"

    metadata = kit_path("KIT_METADATA_PATH")
    with_screenshots = kit_flag?("KIT_METADATA_SCREENSHOTS")
    # deliver creates its screenshots dir on login; without the flag give it a throwaway one,
    # so the app's screenshots directory is neither created nor touched.
    unused = Dir.mktmpdir("kit-screenshots")
    screenshots = with_screenshots ? kit_path("KIT_SCREENSHOTS_PATH") : unused
    available = Deliver::Options.available_options
    # As `deliver download_metadata` does: a stray .ipa/.pkg next to the Fastfile is irrelevant here.
    available.each do |opt|
      next unless %i[ipa pkg app_rating_config_path].include?(opt.key)

      opt.verify_block = nil
      opt.conflicting_options = nil
    end
    options = FastlaneCore::Configuration.create(
      available,
      api_key: kit_asc_api_key,
      app_identifier: kit_ios_bundle_id,
      metadata_path: metadata,
      screenshots_path: screenshots,
      force: true
    )
    Deliver::Runner.new(options, skip_version: true) # logs in and finds the app; uploads nothing
    app = Deliver.cache[:app]
    platform = Spaceship::ConnectAPI::Platform.map(options[:platform])
    version = app.get_latest_app_store_version(platform: platform)
    UI.user_error!("#{kit_ios_bundle_id} has no App Store version to download a listing from.") unless version

    Deliver::Setup.new.generate_metadata_files(app, version, metadata, options)
    if with_screenshots
      editing = app.get_edit_app_store_version(platform: platform)
      Deliver::DownloadScreenshots.download({ platform: options[:platform], use_live_version: editing.nil? }, screenshots)
    end
    UI.success("Downloaded the App Store listing to #{metadata}#{with_screenshots ? " and #{screenshots}" : ''}.")
  ensure
    FileUtils.remove_entry(unused) if unused && File.exist?(unused)
    # deliver writes the App Review contact and demo login next to the listing; never keep them.
    if metadata && kit_strip_review_information(metadata)
      UI.important("Removed review_information/ (App Review contact and demo login): kit keeps it out of the repo.")
    end
  end

  # Listing only: no binary, no review submission, no release settings.
  # This runs deliver itself rather than upload_to_app_store because the
  # action's defaults are not neutral: phased_release and reset_ratings default
  # to false, and deliver then deletes the phased release (set by
  # upload_appstore) and any ratings reset on the version. With no default
  # deliver leaves both alone, like automatic_release. The .ipa/.pkg defaults
  # (newest in the working directory) go too, so a stray build is never read
  # for a version or platform.
  # deliver edits the version being prepared, so one must exist in App Store
  # Connect; skip_app_version_update keeps it from creating or renaming one.
  # Without one deliver retries for about 20 minutes before failing, so the
  # lane checks first. deliver reads a copy of the metadata directory without
  # review_information/, so the App Review contact and demo login are never sent.
  desc "Upload the App Store listing text; screenshots too when KIT_METADATA_SCREENSHOTS=1 (replaces them)."
  desc "In: KIT_METADATA_PATH, KIT_SCREENSHOTS_PATH, KIT_METADATA_SCREENSHOTS, KIT_IOS_BUNDLE_ID, ASC_*, KIT_SKIP_UPLOAD."
  lane :metadata_push do
    metadata = kit_require_file("KIT_METADATA_PATH")
    next if kit_skip_upload?("the App Store listing upload", metadata)

    require "deliver"

    with_screenshots = kit_flag?("KIT_METADATA_SCREENSHOTS")
    available = Deliver::Options.available_options
    available.each do |opt|
      opt.default_value = nil if %i[phased_release reset_ratings].include?(opt.key)
      next unless %i[ipa pkg].include?(opt.key)

      opt.default_value = nil
      opt.verify_block = nil
      opt.conflicting_options = nil
    end
    # deliver creates its screenshots dir even when it skips them; give it a throwaway one then.
    Dir.mktmpdir("kit-listing") do |tmp|
      unused = File.join(tmp, "screenshots")
      options = FastlaneCore::Configuration.create(
        available,
        api_key: kit_asc_api_key,
        app_identifier: kit_ios_bundle_id,
        metadata_path: kit_metadata_for_push(metadata, File.join(tmp, "metadata")),
        screenshots_path: with_screenshots ? kit_require_file("KIT_SCREENSHOTS_PATH") : unused,
        skip_binary_upload: true,
        skip_app_version_update: true,
        skip_metadata: false,
        skip_screenshots: !with_screenshots,
        overwrite_screenshots: with_screenshots,
        submit_for_review: false,
        run_precheck_before_submit: false,
        force: true # skip the interactive HTML preview
      )
      runner = Deliver::Runner.new(options) # logs in and finds the app; uploads nothing yet
      platform = Spaceship::ConnectAPI::Platform.map(options[:platform])
      kit_require_editable_version(Deliver.cache[:app], platform, kit_ios_bundle_id)
      runner.run
    end
    UI.success("Updated the App Store listing#{with_screenshots ? ' and screenshots' : ''}.")
  end
end

# --------------------------------------------------------------- Android ---

def kit_play_json_key
  kit_require_file("KIT_PLAY_JSON_KEY")
end

# kit track name (or Play track name) -> Play track name.
def kit_play_track
  tracks = { "internal" => "internal", "alpha" => "alpha", "beta" => "beta",
             "prod" => "production", "production" => "production" }
  track = kit_env("KIT_PLAY_TRACK")
  tracks.fetch(track) { UI.user_error!("Unknown KIT_PLAY_TRACK '#{track}' (#{tracks.keys.join(', ')})") }
end

# Newest signed artifact under <gradle root>/<module dir>/build/outputs. Used
# only when the gradle action did not report its outputs. Newest by mtime: the
# dir can hold stale artifacts from older runs.
def kit_find_artifact(kind)
  module_dir = kit_env_opt("KIT_ANDROID_MODULE", ":android").delete_prefix(":").tr(":", "/")
  sub = kind == "apk" ? "apk/release" : "bundle/release"
  dir = File.join(kit_path("KIT_GRADLE_ROOT"), module_dir, "build/outputs", sub)
  Dir.glob(File.join(dir, "*.#{kind}")).reject { |f| f.include?("unsigned") }.max_by { |f| File.mtime(f) }
end

# metadata_pull helper. `expected` maps a Play image type to how many images
# the listing has. Returns "<language>/<type> (<got> of <want>)" for each type
# with fewer image files written since `since`: supply stores single images as
# <language>/images/<type>.<ext> and screenshots as files in
# <language>/images/<type>/. Only a non-empty .png/.jpg/.jpeg counts: supply
# writes the HTTP body whatever the status, and names the file `<type>.` when
# it cannot tell the image type, so a 403 or 5xx body is not an image.
def kit_play_missing_images(metadata, language, expected, since)
  images = File.join(metadata, language, "images")
  expected.filter_map do |type, want|
    next if want.zero?

    path = File.join(images, type)
    files = File.directory?(path) ? Dir.glob(File.join(path, "*")) : Dir.glob("#{path}.*")
    got = files.count do |f|
      File.file?(f) && File.size(f).positive? && f.match?(/\.(png|jpe?g)\z/i) && File.mtime(f) >= since - 1
    end
    "#{language}/#{type} (#{got} of #{want})" if got < want
  end
end

platform :android do
  desc "Print the next version code: max across every Play track + 1."
  desc "In: KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY. Out: KIT_NEXT_CODE=<n>."
  lane :next_code do
    json_key = kit_play_json_key
    package = kit_env("KIT_ANDROID_PACKAGE")
    codes = []
    # A build promoted to production can hold the highest code while alpha and
    # beta lag, so take the max across every track.
    %w[internal alpha beta production].each do |t|
      codes.concat(google_play_track_version_codes(track: t, json_key: json_key, package_name: package))
    rescue StandardError => e
      UI.important("Could not fetch version codes for the '#{t}' track: #{e.message}")
    end
    latest = codes.max || 0
    if latest.zero?
      UI.user_error!("No version codes in any Play track. Upload the first build with `kit release android --code 1`.")
    end
    UI.message("Existing Play version codes: #{codes.uniq.sort.join(', ')}")
    kit_emit("NEXT_CODE", latest + 1)
  end

  # Signing: kit.release (PLAN §13.4) reads -Pkit.keystoreFile plus
  # ANDROID_KEYSTORE_ALIAS / ANDROID_KEYSTORE_PASSWORD from the inherited env.
  # Passwords never go on argv.
  desc "Build the signed release bundle (or APK) with Gradle."
  desc "In: KIT_GRADLE_ROOT, KIT_ANDROID_MODULE (default :android), KIT_GRADLE_TASK (default <module>:bundleRelease), " \
       "KIT_ANDROID_VERSION, KIT_ANDROID_CODE, KIT_ANDROID_KEYSTORE_FILE. Out: KIT_ARTIFACT_AAB= or KIT_ARTIFACT_APK=."
  lane :build do
    module_path = kit_env_opt("KIT_ANDROID_MODULE", ":android")
    task = kit_env_opt("KIT_GRADLE_TASK", "#{module_path}:bundleRelease")
    kind = task.end_with?("bundleRelease") ? "aab" : "apk"

    props = {}
    props["kit.versionName"] = kit_env_opt("KIT_ANDROID_VERSION") if kit_env_opt("KIT_ANDROID_VERSION")
    props["kit.versionCode"] = kit_env_opt("KIT_ANDROID_CODE") if kit_env_opt("KIT_ANDROID_CODE")
    props["kit.keystoreFile"] = kit_path("KIT_ANDROID_KEYSTORE_FILE") if kit_env_opt("KIT_ANDROID_KEYSTORE_FILE")

    gradle(
      task: task,
      project_dir: kit_path("KIT_GRADLE_ROOT"),
      properties: props,
      print_command_output: !ENV["CI"]
    )

    artifact = if kind == "aab"
                 lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
               else
                 lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
               end
    artifact = kit_find_artifact(kind) if artifact.nil? || artifact.include?("unsigned") || !File.exist?(artifact)
    UI.user_error!("Gradle task #{task} produced no signed .#{kind}") if artifact.nil?
    kit_emit(kind == "aab" ? "ARTIFACT_AAB" : "ARTIFACT_APK", artifact)
  end

  desc "Upload a built AAB to a Google Play track (internal, alpha, beta, production)."
  desc "In: KIT_ANDROID_AAB, KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY, KIT_PLAY_TRACK, KIT_PLAY_ROLLOUT (production, " \
       "default 0.1), KIT_PLAY_DRAFT, KIT_RELEASE_NOTES + KIT_ANDROID_CODE (changelog), KIT_SKIP_UPLOAD."
  lane :upload_play do
    aab = kit_require_file("KIT_ANDROID_AAB")
    track = kit_play_track
    next if kit_skip_upload?("the Play upload (#{track})", aab)

    # A Play app whose first release was never rolled out is a "draft app"; the
    # API rejects any release on it that is not itself a draft.
    draft = kit_flag?("KIT_PLAY_DRAFT")
    params = {
      package_name: kit_env("KIT_ANDROID_PACKAGE"),
      track: track,
      aab: aab,
      json_key: kit_play_json_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }

    if track == "production"
      # Staged by default; a full release must be asked for with rollout 1.
      # supply keeps an explicit inProgress at 1.0 and drops the fraction,
      # which Play rejects. Production "What's new" is managed in the console.
      rollout = kit_env_opt("KIT_PLAY_ROLLOUT", "0.1")
      if draft
        params[:release_status] = "draft"
      elsif rollout.to_f >= 1
        params[:release_status] = "completed"
      else
        params[:release_status] = "inProgress"
        params[:rollout] = rollout
      end
    else
      params[:release_status] = "draft" if draft
    end

    notes = kit_env_opt("KIT_RELEASE_NOTES", "")
    code = kit_env_opt("KIT_ANDROID_CODE")
    Dir.mktmpdir("kit-play-metadata") do |metadata|
      if track != "production" && !notes.empty? && code
        locale = kit_env_opt("KIT_PLAY_LOCALE", "en-US")
        dir = File.join(metadata, locale, "changelogs")
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, "#{code}.txt"), notes[0, 500])
        params[:metadata_path] = metadata
        params[:skip_upload_changelogs] = false
      end
      upload_to_play_store(params)
    end
    UI.success("Uploaded to the Play '#{track}' track#{draft ? ' as a draft (roll it out in the Play Console)' : ''}.")
  end

  # `supply init` refuses a directory that already exists and also needs a
  # production release (it downloads changelogs). This runs the same
  # Supply::Setup steps for the listing only; changelogs stay with
  # `upload_play`. The edit is read-only and is discarded.
  desc "Download the Play listing text into the app's metadata directory; images and screenshots too when KIT_METADATA_SCREENSHOTS=1."
  desc "In: KIT_METADATA_PATH, KIT_METADATA_SCREENSHOTS, KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY."
  lane :metadata_pull do
    require "supply"
    require "supply/options"
    require "supply/setup"

    metadata = kit_path("KIT_METADATA_PATH")
    package = kit_env("KIT_ANDROID_PACKAGE")
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      package_name: package,
      json_key: kit_play_json_key,
      metadata_path: metadata
    )
    with_images = kit_flag?("KIT_METADATA_SCREENSHOTS")
    setup = Supply::Setup.new
    client = setup.send(:client) # the client Setup downloads images with; it holds the edit
    client.begin_edit(package_name: package)
    missing = []
    begin
      client.listings.each do |listing|
        setup.store_metadata(listing)
        next unless with_images

        # download_images logs a failed image type and carries on, so count what Play has
        # first and check the files afterwards.
        expected = (Supply::IMAGES_TYPES + Supply::SCREENSHOT_TYPES).to_h do |type|
          [type, client.fetch_images(image_type: type, language: listing.language).length]
        end
        started = Time.now
        setup.download_images(listing)
        missing.concat(kit_play_missing_images(metadata, listing.language, expected, started))
      end
    ensure
      client.abort_current_edit
    end
    unless missing.empty?
      UI.user_error!("Play images failed to download: #{missing.join(', ')}. The text is in #{metadata}; run the pull again.")
    end
    UI.success("Downloaded the Play listing#{with_images ? ', images and screenshots' : ''} to #{metadata}.")
  end

  # Listing only: no AAB/APK, no changelogs, no rollout or promotion (supply
  # touches a track only for a binary, `rollout` or `track_promote_to`).
  # supply still wants one release to hang the edit on and fails when a track
  # holds several (a staged rollout), so pick the newest version code of the
  # first track that has any.
  desc "Upload the Play listing text; images and screenshots too when KIT_METADATA_SCREENSHOTS=1 (replaces them)."
  desc "In: KIT_METADATA_PATH, KIT_METADATA_SCREENSHOTS, KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY, KIT_SKIP_UPLOAD."
  lane :metadata_push do
    metadata = kit_require_file("KIT_METADATA_PATH")
    next if kit_skip_upload?("the Play listing upload", metadata)

    json_key = kit_play_json_key
    package = kit_env("KIT_ANDROID_PACKAGE")
    with_images = kit_flag?("KIT_METADATA_SCREENSHOTS")
    track = nil
    code = nil
    %w[production beta alpha internal].each do |t|
      codes = begin
        google_play_track_version_codes(track: t, json_key: json_key, package_name: package)
      rescue StandardError => e
        UI.important("Could not fetch version codes for the '#{t}' track: #{e.message}")
        []
      end
      next if codes.empty?

      track = t
      code = codes.max
      break
    end
    UI.user_error!("No release on any Play track: upload a build with `kit release android` before pushing the listing.") unless track

    upload_to_play_store(
      package_name: package,
      json_key: json_key,
      metadata_path: metadata,
      track: track,
      version_code: code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: !with_images,
      skip_upload_screenshots: !with_images
    )
    UI.success("Updated the Play listing#{with_images ? ', images and screenshots' : ''}.")
  end
end

# ------------------------------------------- status, promote, rollout ---
# `kit release status|promote|rollout`: no lane here builds or uploads a binary.
# The selection helpers (which build, which release, which group) are plain
# methods over the API objects so `test/fastlane` can run them against stubs.

# A track that cannot be read is reported, not fatal: kit shows it as unknown.
def kit_status_error(key, error)
  message = error.message.to_s.lines.first.to_s.strip
  UI.important("Could not read #{key.downcase}: #{message}")
  kit_emit("STATUS_#{key}_ERROR", message)
end

# Spaceship calls outside an action (groups, builds, the phased release) need the token set.
def kit_asc_login
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: kit_asc_api_key)
end

def kit_ios_app
  app = Spaceship::ConnectAPI::App.find(kit_ios_bundle_id)
  UI.user_error!("No app with bundle id #{kit_ios_bundle_id} in App Store Connect") unless app
  app
end

# nil when the version has no phased release: Spaceship raises a bare
# RuntimeError "No data" for that answer. Anything else (auth, network) is a
# real failure and must not read as "no phased release".
def kit_ios_phased_release(version)
  version.fetch_app_store_version_phased_release
rescue RuntimeError => e
  raise unless e.instance_of?(RuntimeError) && e.message == "No data"

  nil
end

# Group names (or ids) -> the app's TestFlight groups. pilot skips a name it
# cannot match and still reports success, so a miss fails here.
def kit_ios_resolve_groups(all_groups, names)
  names.map do |name|
    all_groups.find { |g| g.name == name || g.id == name } ||
      UI.user_error!("No TestFlight group '#{name}' for this app (groups: #{all_groups.map(&:name).join(', ')})")
  end
end

# Builds of one version that were distributed to one TestFlight group.
def kit_ios_group_builds(app, group, version)
  Spaceship::ConnectAPI.get_builds(
    filter: { app: app.id, betaGroups: group.id, "preReleaseVersion.version" => version, expired: "false" },
    includes: "preReleaseVersion",
    sort: "-uploadedDate",
    limit: 200
  ).all_pages.flat_map(&:to_models)
end

# A source group must receive its builds explicitly (the groups
# `kit release ios --track alpha|beta` distributes to). A group with automatic
# distribution (hasAccessToAllBuilds, App Store Connect's default for an
# internal group) holds every upload, `--track internal` builds included, and
# kit cannot tell those apart there.
def kit_ios_require_explicit_group(group)
  return group unless group.has_access_to_all_builds

  UI.user_error!(
    "The TestFlight group '#{group.name}' receives every build automatically, internal (KIT_INTERNAL) builds " \
    "included, so kit cannot tell which of its builds may be promoted. Promotion needs a source group that " \
    "receives builds explicitly: the one `kit release ios --track alpha|beta` distributes to " \
    "(release.ios.testflightGroups), with automatic distribution off."
  )
end

# The build to promote, from the source group's builds only: `number` when
# given, else the highest build number. An internal build (compiled with
# KIT_INTERNAL, sent to no group) is not among them, as long as the group
# receives builds explicitly (kit_ios_require_explicit_group).
def kit_ios_select_build(builds, number, version, group_name)
  if number
    builds.find { |b| b.version.to_s == number.to_s } ||
      UI.user_error!("Build #{number} of #{version} is not in the TestFlight group '#{group_name}': only a build " \
                     "released to that group can be promoted (internal builds are never promoted)")
  else
    builds.max_by { |b| b.version.to_i } ||
      UI.user_error!("No build of #{version} in the TestFlight group '#{group_name}': nothing to promote")
  end
end

# [app, build]: looked up and checked against the source group before anything is changed.
def kit_ios_promote_build
  kit_asc_login
  app = kit_ios_app
  version = kit_env("KIT_IOS_VERSION")
  group = kit_ios_resolve_groups(app.get_beta_groups, [kit_env("KIT_TESTFLIGHT_FROM_GROUP")]).first
  kit_ios_require_explicit_group(group)
  builds = kit_ios_group_builds(app, group, version)
  [app, kit_ios_select_build(builds, kit_env_opt("KIT_IOS_BUILD"), version, group.name)]
end

platform :ios do
  desc "Print the latest TestFlight build and the live App Store build."
  desc "In: KIT_IOS_BUNDLE_ID, KIT_IOS_VERSION (optional: TestFlight builds of this version only), ASC_*. " \
       "Out: KIT_STATUS_TESTFLIGHT_BUILD=, KIT_STATUS_TESTFLIGHT_VERSION=, KIT_STATUS_APPSTORE_BUILD=, " \
       "KIT_STATUS_APPSTORE_VERSION=, KIT_STATUS_APPSTORE_PHASED= (or KIT_STATUS_APPSTORE_PHASED_ERROR=), " \
       "KIT_STATUS_<TRACK>_ERROR= (empty BUILD = no build)."
  lane :status do
    api_key = kit_asc_api_key
    bundle_id = kit_ios_bundle_id
    begin
      params = { api_key: api_key, app_identifier: bundle_id, initial_build_number: 0 }
      version = kit_env_opt("KIT_IOS_VERSION")
      params[:version] = version if version
      build = latest_testflight_build_number(params).to_i
      kit_emit("STATUS_TESTFLIGHT_BUILD", build.zero? ? "" : build)
      kit_emit("STATUS_TESTFLIGHT_VERSION", lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]) unless build.zero?
    rescue StandardError => e
      kit_status_error("TESTFLIGHT", e)
    end
    begin
      build = app_store_build_number(api_key: api_key, app_identifier: bundle_id, live: true)
      kit_emit("STATUS_APPSTORE_BUILD", build)
      kit_emit("STATUS_APPSTORE_VERSION", lane_context[SharedValues::LATEST_VERSION])
    rescue StandardError => e
      # An app that was never released has no live version: empty, not unknown.
      if e.message.include?("Could not find a live-version")
        kit_emit("STATUS_APPSTORE_BUILD", "")
      else
        kit_status_error("APPSTORE", e)
      end
    end
    begin
      kit_asc_login
      live = kit_ios_app.get_live_app_store_version
      phased = live && kit_ios_phased_release(live)
      kit_emit("STATUS_APPSTORE_PHASED", phased.phased_release_state) if phased
    rescue StandardError => e
      # Not the same as "no phased release": kit shows the phased state as unknown.
      UI.important("Could not read the phased release: #{e.message}")
      kit_emit("STATUS_APPSTORE_PHASED_ERROR", e.message.to_s.lines.first.to_s.strip)
    end
  end

  desc "Print the build a promotion would move: it must be in the source TestFlight group."
  desc "In: KIT_IOS_BUNDLE_ID, KIT_IOS_VERSION, KIT_TESTFLIGHT_FROM_GROUP, KIT_IOS_BUILD (optional: check this " \
       "build; default the highest build number in the group), ASC_*. Out: KIT_PROMOTE_BUILD=<n>."
  lane :promote_build do
    _app, build = kit_ios_promote_build
    kit_emit("PROMOTE_BUILD", build.version)
  end

  desc "Distribute a build from one TestFlight group to others (no upload)."
  desc "In: KIT_IOS_BUNDLE_ID, KIT_IOS_VERSION, KIT_TESTFLIGHT_FROM_GROUP, KIT_IOS_BUILD (optional), " \
       "KIT_TESTFLIGHT_GROUPS (comma list: the destination groups), KIT_RELEASE_NOTES (optional: replaces What " \
       "to Test), KIT_TESTFLIGHT_WAIT_TIMEOUT (seconds, default 900), ASC_*."
  lane :promote_testflight do
    names = kit_list("KIT_TESTFLIGHT_GROUPS")
    UI.user_error!("KIT_TESTFLIGHT_GROUPS is empty: a promotion needs the destination tester group") if names.empty?
    app, build = kit_ios_promote_build
    groups = kit_ios_resolve_groups(app.get_beta_groups, names).map(&:name)
    params = {
      api_key: kit_asc_api_key,
      app_identifier: kit_ios_bundle_id,
      distribute_only: true,
      app_version: kit_env("KIT_IOS_VERSION"),
      build_number: build.version.to_s,
      distribute_external: true,
      groups: groups,
      # The build exists (looked up above); never poll without an end for one still processing.
      wait_processing_timeout_duration: kit_env_opt("KIT_TESTFLIGHT_WAIT_TIMEOUT", "900").to_i
    }
    notes = kit_env_opt("KIT_RELEASE_NOTES")
    params[:changelog] = notes if notes
    upload_to_testflight(params)
    UI.success("Distributed build #{build.version} to TestFlight groups: #{groups.join(', ')}.")
  end

  desc "Submit a build from a TestFlight group for App Store review (no upload)."
  desc "In: KIT_IOS_BUNDLE_ID, KIT_IOS_VERSION, KIT_TESTFLIGHT_FROM_GROUP, KIT_IOS_BUILD (optional), " \
       "KIT_RELEASE_NOTES (What's New, en-US), KIT_APPSTORE_PHASED (default 1), KIT_APPSTORE_SUBMIT (default 1), ASC_*."
  lane :promote_appstore do
    whats_new = kit_env_opt("KIT_RELEASE_NOTES", "")
    UI.user_error!("KIT_RELEASE_NOTES is empty: App Store Connect will not submit an update without What's New.") if whats_new.empty?
    _app, build = kit_ios_promote_build

    # Same submit, phased and What's New rules as upload_appstore, and the same
    # empty metadata dir: deliver must not load the repo's listing.
    Dir.mktmpdir("kit-deliver") do |empty|
      upload_to_app_store(
        api_key: kit_asc_api_key,
        app_identifier: kit_ios_bundle_id,
        app_version: kit_env("KIT_IOS_VERSION"),
        build_number: build.version.to_s,
        skip_binary_upload: true,
        submit_for_review: kit_flag?("KIT_APPSTORE_SUBMIT", default: true),
        automatic_release: false,
        phased_release: kit_flag?("KIT_APPSTORE_PHASED", default: true),
        precheck_include_in_app_purchases: false,
        release_notes: { "en-US" => whats_new },
        metadata_path: File.join(empty, "metadata"),
        screenshots_path: File.join(empty, "screenshots"),
        skip_screenshots: true,
        force: true
      )
    end
    UI.success("Submitted build #{build.version} to the App Store for review.")
  end

  # The App Store has no rollout percentage: a phased release follows Apple's
  # fixed 7-day schedule and can only be paused, resumed or completed.
  desc "Pause, resume or complete the phased release of the live App Store version."
  desc "In: KIT_ROLLOUT_ACTION (halt|resume|complete), KIT_IOS_BUNDLE_ID, ASC_*. " \
       "Out: KIT_ROLLOUT_VERSION=, KIT_ROLLOUT_STATE=."
  lane :rollout do
    action = kit_env("KIT_ROLLOUT_ACTION")
    UI.user_error!("KIT_ROLLOUT_ACTION must be halt, resume or complete, got '#{action}'") unless %w[halt resume complete].include?(action)

    kit_asc_login
    live = kit_ios_app.get_live_app_store_version
    UI.user_error!("No live App Store version for #{kit_ios_bundle_id}") unless live
    phased = kit_ios_phased_release(live)
    UI.user_error!("#{live.version_string} has no phased release (it was released to everyone at once)") unless phased

    state = phased.phased_release_state
    allowed = { "halt" => %w[ACTIVE], "resume" => %w[PAUSED], "complete" => %w[ACTIVE PAUSED] }.fetch(action)
    UI.user_error!("Cannot #{action} the phased release of #{live.version_string}: it is #{state}") unless allowed.include?(state)

    updated = case action
              when "halt" then phased.pause
              when "resume" then phased.resume
              else phased.complete
              end
    kit_emit("ROLLOUT_VERSION", live.version_string)
    kit_emit("ROLLOUT_STATE", updated ? updated.phased_release_state : state)
  end
end

# kit track name (or Play track name) -> Play track name.
def kit_play_track_name(track)
  tracks = { "internal" => "internal", "alpha" => "alpha", "beta" => "beta",
             "prod" => "production", "production" => "production" }
  tracks.fetch(track) { UI.user_error!("Unknown Play track '#{track}' (#{tracks.keys.join(', ')})") }
end

def kit_play_no_upload
  { skip_upload_apk: true, skip_upload_aab: true, skip_upload_metadata: true,
    skip_upload_images: true, skip_upload_screenshots: true, skip_upload_changelogs: true }
end

# The production release a rollout change applies to: the one staged rollout
# in progress, or the halted one for `resume`. Never a draft (supply's own
# rollout update would publish it) and never a guess between two.
def kit_play_rollout_release(releases, action, code)
  want = action == "resume" ? "halted" : "inProgress"
  found = (releases || []).select { |r| r.status == want }
  found = found.select { |r| (r.version_codes || []).map(&:to_s).include?(code.to_s) } if code
  if found.empty?
    why = want == "halted" ? "there is no halted rollout to resume" : "no staged rollout is in progress (resume a halted one first)"
    UI.user_error!("No #{want} release on the production track#{code ? " with version code #{code}" : ''}: #{why}")
  end
  if found.size > 1
    codes = found.flat_map { |r| r.version_codes || [] }.join(", ")
    UI.user_error!("More than one #{want} release on the production track (version codes #{codes}): pass --build <version code>")
  end
  found.first
end

# Set the release's status and user fraction for the action. Halt and resume
# keep the fraction the rollout had. A release halted with no fraction was at
# 100%: Play rejects it as inProgress, and completing it is the user's call.
def kit_play_apply_rollout(release, action, fraction)
  case action
  when "percent"
    value = fraction.to_f
    UI.user_error!("KIT_PLAY_ROLLOUT must be in (0, 1], got '#{fraction}'") unless value.positive? && value <= 1
    release.status = value >= 1 ? "completed" : "inProgress"
    release.user_fraction = value >= 1 ? nil : value
  when "complete"
    release.status = "completed"
    release.user_fraction = nil
  when "halt"
    release.status = "halted"
  when "resume"
    if release.user_fraction.nil?
      codes = (release.version_codes || []).join(", ")
      UI.user_error!("The halted release (version code #{codes}) was halted at 100%, so there is no staged rollout " \
                     "to resume. Release it to everyone with `kit release rollout android --complete`.")
    end
    release.status = "inProgress"
  else
    UI.user_error!("KIT_ROLLOUT_ACTION must be percent, halt, resume or complete, got '#{action}'")
  end
  release
end

# One Play edit: pick the release, change it, commit. Not the supply action:
# its rollout update also matches draft releases, cannot find a halted one and
# overwrites the user fraction.
def kit_play_update_rollout(action, fraction, code)
  require "supply"
  package = kit_env("KIT_ANDROID_PACKAGE")
  Supply.config = FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    { json_key: kit_play_json_key, package_name: package, track: "production" }
  )
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: package)
  begin
    track = client.tracks("production").first
    UI.user_error!("The app has no production track") unless track
    release = kit_play_apply_rollout(kit_play_rollout_release(track.releases, action, code), action, fraction)
    # Play keeps the track's other releases when the update names only this one.
    track.releases = [release]
    client.update_track("production", track)
    client.commit_current_edit!
    release
  rescue StandardError
    begin
      client.abort_current_edit
    rescue StandardError
      nil
    end
    raise
  end
end

platform :android do
  desc "Print the version codes and release names on each Play track."
  desc "In: KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY, KIT_STATUS_TRACKS (comma list, default every track). " \
       "Out per track: KIT_STATUS_<TRACK>_CODES=<a,b>, KIT_STATUS_<TRACK>_NAMES=<json array>, KIT_STATUS_<TRACK>_ERROR=."
  lane :status do
    json_key = kit_play_json_key
    package = kit_env("KIT_ANDROID_PACKAGE")
    tracks = kit_list("KIT_STATUS_TRACKS").map { |t| kit_play_track_name(t) }
    tracks = %w[internal alpha beta production] if tracks.empty?
    tracks.each do |t|
      key = t.upcase
      begin
        codes = google_play_track_version_codes(track: t, json_key: json_key, package_name: package)
        kit_emit("STATUS_#{key}_CODES", codes.sort.join(","))
      rescue StandardError => e
        kit_status_error(key, e)
        next
      end
      begin
        names = google_play_track_release_names(track: t, json_key: json_key, package_name: package)
        kit_emit("STATUS_#{key}_NAMES", names.compact.to_json)
      rescue StandardError => e
        UI.important("Could not fetch release names for the '#{t}' track: #{e.message}")
      end
    end
  end

  # Internal builds are compiled with KIT_INTERNAL set and are never promoted.
  desc "Promote a release from one Play track to a later one (no upload, no rebuild)."
  desc "In: KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY, KIT_PLAY_TRACK (from: alpha|beta), KIT_PLAY_PROMOTE_TO " \
       "(beta|prod), KIT_ANDROID_CODE (optional: the version code to promote), KIT_PLAY_ROLLOUT (production, " \
       "default 0.1), KIT_PLAY_DRAFT, KIT_RELEASE_NOTES (changelog; not for production)."
  lane :promote do
    from = kit_play_track
    to = kit_play_track_name(kit_env("KIT_PLAY_PROMOTE_TO"))
    UI.user_error!("Internal builds are never promoted (they are built with KIT_INTERNAL): rebuild for #{to}") if from == "internal"

    draft = kit_flag?("KIT_PLAY_DRAFT")
    code = kit_env_opt("KIT_ANDROID_CODE")
    params = kit_play_no_upload.merge(
      package_name: kit_env("KIT_ANDROID_PACKAGE"),
      json_key: kit_play_json_key,
      track: from,
      track_promote_to: to
    )
    params[:version_code] = code.to_i if code

    # Same staged default and draft handling as upload_play.
    if draft
      params[:track_promote_release_status] = "draft"
    elsif to == "production"
      rollout = kit_env_opt("KIT_PLAY_ROLLOUT", "0.1")
      if rollout.to_f >= 1
        params[:track_promote_release_status] = "completed"
      else
        params[:track_promote_release_status] = "inProgress"
        params[:rollout] = rollout
      end
    else
      params[:track_promote_release_status] = "completed"
    end

    notes = kit_env_opt("KIT_RELEASE_NOTES", "")
    Dir.mktmpdir("kit-play-metadata") do |metadata|
      if to != "production" && !notes.empty? && code
        locale = kit_env_opt("KIT_PLAY_LOCALE", "en-US")
        dir = File.join(metadata, locale, "changelogs")
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, "#{code}.txt"), notes[0, 500])
        params[:metadata_path] = metadata
        params[:skip_upload_changelogs] = false
      end
      upload_to_play_store(params)
    end
    UI.success("Promoted #{code ? "version code #{code}" : 'the release'} from '#{from}' to '#{to}'#{draft ? ' as a draft' : ''}.")
  end

  desc "Change the production staged rollout: set the fraction, halt, resume or complete it."
  desc "In: KIT_ROLLOUT_ACTION (percent|halt|resume|complete), KIT_PLAY_ROLLOUT (percent: fraction in (0, 1]), " \
       "KIT_ANDROID_CODE (optional: the release's version code), KIT_ANDROID_PACKAGE, KIT_PLAY_JSON_KEY. " \
       "Out: KIT_ROLLOUT_STATE=, KIT_ROLLOUT_FRACTION=, KIT_ROLLOUT_CODE=."
  lane :rollout do
    action = kit_env("KIT_ROLLOUT_ACTION")
    UI.user_error!("KIT_ROLLOUT_ACTION must be percent, halt, resume or complete, got '#{action}'") unless %w[percent halt resume complete].include?(action)

    fraction = action == "percent" ? kit_env("KIT_PLAY_ROLLOUT") : nil
    release = kit_play_update_rollout(action, fraction, kit_env_opt("KIT_ANDROID_CODE"))
    kit_emit("ROLLOUT_STATE", release.status)
    kit_emit("ROLLOUT_FRACTION", release.user_fraction) if release.user_fraction
    kit_emit("ROLLOUT_CODE", (release.version_codes || []).map(&:to_i).max)
  end
end
