{
  "name": "@jordond/kit",
  "version": "0.7.1",
  "description": "One dev toolkit for every app: CLI, shared fastlane, Gradle conventions",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordond/kit.git"
  },
  "bin": {
    "kit": "bin/kit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "fastlane",
    "gradle/maven",
    "templates"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/cli.ts src/index.ts --outdir dist --target bun --splitting --external zod && bun build src/lib/storeshots/page/main.ts --target browser --outfile dist/shots-page.js && tsc -p tsconfig.build.json",
    "build:gradle": "gradle/gradlew -p gradle publishKit",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "test:pack": "KIT_PACK_TEST=1 bun test test/pack",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "gunshi": "0.37.3",
    "@gunshi/plugin-completion": "0.37.3",
    "listr2": "^11.4.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
