{
  "name": "@jordond/kit",
  "version": "0.9.0",
  "description": "One dev toolkit for every app: CLI, shared fastlane, Gradle conventions",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordond/kit.git"
  },
  "bin": {
    "kit": "bin/kit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "fastlane",
    "gradle/maven",
    "templates"
  ],
  "workspaces": [
    "editor"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "vp pack && vp -C editor build",
    "dev:studio": "bun scripts/dev-studio.ts",
    "build:gradle": "gradle/gradlew -p gradle publishKit",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "test:pack": "KIT_PACK_TEST=1 bun test test/pack",
    "check": "vp check --deny-warnings",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "gunshi": "0.37.3",
    "@gunshi/plugin-completion": "0.37.3",
    "listr2": "^11.4.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0",
    "zod": "^4.6.7"
  }
}
