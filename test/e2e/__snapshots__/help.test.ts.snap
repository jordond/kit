// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`help kit --help 1`] = `
"kit

Usage
  kit <command> [options]

Develop
  dev         Run a dev server
  build       Build every target
  deploy      Deploy a target
  app         Build, install and launch the debug app on a device …
  device      Simulators, emulators and connected devices …
  maestro     Run the Maestro CLI (arguments pass through)
  fixture     Replay or capture app state on a device …
  open        Open a worker target's Cloudflare dashboard page
  gradle      Run ./gradlew in the Gradle root
  kotlin      Run the Kotlin toolchain wrapper in toolchain.root
  wrangler    Run wrangler in a worker target's directory
  xcode       Open the iOS project in Xcode
  clean       Remove build output

Quality
  lint        Lint every target
  format      Format every target
  typecheck   Typecheck every target
  check       Lint and typecheck every target
  test        Run the test suites
  qa          Run the Maestro flows on a device: build, install, fixture, flows
  shots       Capture screenshots with the Maestro flows: 9:41 status bar, fixture, PNGs …

Release
  release     Ship to the stores …
  version     Version names in the catalog TOML …
  fastlane    Run fastlane with kit's shared Fastfile
  changelog   List the changes since the last release tag

Infra
  env         Render, check and push env from .env …
  db          Cloudflare D1 migrations, queries, backup, restore, seed and reset …
  logs        Tail a deployed worker's logs

Setup
  doctor      Check tools, versions and .env
  init        Set up a fresh clone, or add kit to a new repo
  add         Scaffold a module or a target into this repo …
  deps        List or update npm dependencies (catalog-aware)
  upgrade     Move the @jordond/kit pin and the workflow SHAs to a kit release
  config      Print the resolved kit.config.ts
  completion  Print a shell completion script

"
`;

exports[`help kit add --help 1`] = `
"Scaffold a module or a target into this repo

Usage
  kit add <command> [options]

Commands
  module  Add a KMP library module (Gradle or Kotlin toolchain)
  target  Add a target to kit.config.ts

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit app --help 1`] = `
"Build, install and launch the debug app on a device

Usage
  kit app <command> [options]

Commands
  build      Build the debug app for a platform and print the artifact path
  install    Build and install the app on a device, simulator or emulator
  run        Build, install and launch the app
  uninstall  Remove the app from a device
  clear      Wipe the app's data on a device

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit db --help 1`] = `
"Cloudflare D1 migrations, queries, backup, restore, seed and reset

Usage
  kit db <command> [options]

Commands
  migrate  Apply pending D1 migrations
  list     List D1 migrations
  create   Create a D1 migration
  exec     Run SQL against D1
  backup   Export a D1 database to a .sql file
  restore  Run a .sql backup against D1
  seed     Run a D1 database's seed file
  reset    Recreate a local D1 database: migrate, then seed

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit device --help 1`] = `
"Simulators, emulators and connected devices

Usage
  kit device <command> [options]

Commands
  list       List simulators, emulators and connected devices
  boot       Boot a simulator or emulator, creating one when none exists
  statusbar  Pin the status bar to 9:41 with full signal and battery; --clear restores it

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit env --help 1`] = `
"Render, check and push env from .env

Usage
  kit env <command> [options]

Commands
  sync    Render env outputs (.dev.vars) from .env
  check   Validate .env and check outputs for drift
  push    Push secrets with wrangler and gh
  init    Create .env and ask for missing keys
  rotate  Generate a new value for a key and sync

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit fixture --help 1`] = `
"Replay or capture app state on a device

Usage
  kit fixture <command> [options]

Commands
  load  Replay a fixture (app state) onto a device
  dump  Capture the app's state from a device into a fixture

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit release --help 1`] = `
"Ship to the stores

Usage
  kit release <command> [options]

Commands
  ios       Build and upload iOS to a track
  android   Build and upload Android to a track
  certs     Install App Store signing with match; --add creates what is missing
  status    Show the version and the latest build on each store track
  promote   Promote a build the store already has to a later track (no rebuild)
  rollout   Change the production rollout: Play staged rollout, App Store phased release
  metadata  Sync the store listing (text, screenshots) …
  rollback  Roll a worker service back to an earlier version

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit shots --help 1`] = `
"Capture screenshots with the Maestro flows: 9:41 status bar, fixture, PNGs

Usage
  kit shots <command> [options]

Examples
  kit shots android
  kit shots ios --full
  kit shots ipad --no-build --out brand/screenshots/ipad
  kit shots android --dry-run --json

Commands
  export  Render the store screenshots from the raw shots and the saved project

Options
  -h, --help              Show help
  -V, --version           Show kit version
      --json              Write one JSON document to stdout; no prompts or animation
  -n, --dry-run           Plan and run read-only steps; skip mutations
  -y, --yes               Accept confirmations (never skips prod)
  -v, --verbose           Stream all child output
  -q, --quiet             Errors and summary only
      --bail              Stop at the first failure
      --suite <string>    Run this maestro.suites entry
      --device <string>   Simulator UDID or adb serial (default: the running one)
      --no-build          Install the newest existing build
      --fixture <string>  Load this fixture instead of the suite's
      --no-fixture        Load no fixture
      --full              Run the shots-full suite (define it under maestro.suites)
      --out <string>      Copy the screenshots here instead of the suite dir (used as is)

"
`;

exports[`help kit version --help 1`] = `
"Version names in the catalog TOML

Usage
  kit version <command> [options]

Commands
  show  Show version names and last release tags
  bump  Bump a version name, commit and push

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit add module --help 1`] = `
"Add a KMP library module to the Gradle build or the Kotlin toolchain project

Usage
  kit add module [options]

Examples
  kit add module core
  kit add module feature:login --compose   # <gradle root>/feature/login
  kit add module data --targets android,jvm --dry-run
  kit add module ui --dir libs/ui

Options
  -h, --help              Show help
  -V, --version           Show kit version
      --json              Write one JSON document to stdout; no prompts or animation
  -n, --dry-run           Plan and run read-only steps; skip mutations
  -y, --yes               Accept confirmations (never skips prod)
  -v, --verbose           Stream all child output
  -q, --quiet             Errors and summary only
      --bail              Stop at the first failure
      --compose           Compose Multiplatform module (applies kit.compose)
      --targets <string>  Comma-separated: android, ios, jvm, js (default android,ios,jvm)
      --dir <string>      Module directory, relative to the Gradle or toolchain root (default: the name)
      --force             Overwrite files that already exist

"
`;

exports[`help kit add target --help 1`] = `
"Add a target to kit.config.ts; a new worker also gets a minimal scaffold

Usage
  kit add target [options]

Examples
  kit add target api --kind worker --dir apps/api
  kit add target web --kind astro --dir apps/web
  kit add target api --kind worker --dir apps/api --dry-run

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --kind <string>  worker | vite | astro | docker | custom
      --dir <string>   Target directory, relative to the repo root

"
`;

exports[`help kit app build --help 1`] = `
"Build the debug app for a platform and print the artifact path

Usage
  kit app build [options]

Examples
  kit app build android
  APK=$(kit app build android)
  kit app build ios --device <udid>
  kit app build android --release
  kit app build android --dry-run --json

Options
  -h, --help             Show help
  -V, --version          Show kit version
      --json             Write one JSON document to stdout; no prompts or animation
  -n, --dry-run          Plan and run read-only steps; skip mutations
  -y, --yes              Accept confirmations (never skips prod)
  -v, --verbose          Stream all child output
  -q, --quiet            Errors and summary only
      --bail             Stop at the first failure
      --release          Build the release variant instead of debug
      --device <string>  Simulator UDID the iOS build targets

"
`;

