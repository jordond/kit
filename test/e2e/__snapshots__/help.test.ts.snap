exports[`help kit env push --help 1`] = `
"Push secrets to Cloudflare workers (wrangler) and GitHub Actions (gh)

Usage
  kit env push [options]

Examples
  kit env push                    # every worker in env.workerSecrets and env.githubSecrets
  kit env push --workers          # every worker, GitHub skipped
