exports[`help kit build --help 1`] = `
"Build every target

Usage
  kit build [options]

Examples
  kit build
  kit build api admin
  kit build client --release

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)
      --release        Gradle or Kotlin toolchain: the signed release bundle (AAB)
      --apk            Gradle: the signed release APK

"
`;

exports[`help kit changelog --help 1`] = `
"List the changes since the last release tag

Usage
  kit changelog [options]

Examples
  kit changelog
  kit changelog --platform ios
  kit changelog --from v0.5.0 --to v0.6.0 --json
  kit changelog --write
  kit changelog --platform api --write docs/api-changes.md

Options
  -h, --help               Show help
  -V, --version            Show kit version
      --json               Write one JSON document to stdout; no prompts or animation
  -n, --dry-run            Plan and run read-only steps; skip mutations
  -y, --yes                Accept confirmations (never skips prod)
  -v, --verbose            Stream all child output
  -q, --quiet              Errors and summary only
      --bail               Stop at the first failure
      --from <string>      Start after this tag or ref (default: the last release tag)
      --to <string>        End at this ref (default: HEAD)
      --platform <string>  ios, android or a service: use its <name>/v* tags
      --all                Include chore, test, ci and style commits
      --write              Add the section to CHANGELOG.md, or to the file named after it

"
`;

exports[`help kit check --help 1`] = `
"Lint and typecheck every target

Usage
  kit check [options]

Examples
  kit check
  kit check api admin web
  kit check --fix
  kit check --affected

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)
  -f, --fix            Format instead of lint, then typecheck

"
`;

exports[`help kit clean --help 1`] = `
"Remove build output

Usage
  kit clean [options]

Examples
  kit clean
  kit clean client
  kit clean --dry-run
  kit clean --deep --yes

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
      --deep     Also node_modules, .wrangler/state (local D1/KV data) and Xcode DerivedData

"
`;

exports[`help kit completion --help 1`] = `
"Print a shell completion script

Usage
  kit completion <shell> [options]

Examples
  # zsh: add to ~/.zshrc (after compinit)
  source <(kit completion zsh)
  # bash: add to ~/.bashrc
  source <(kit completion bash)
  # fish
  kit completion fish > ~/.config/fish/completions/kit.fish

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
  <shell>        zsh, bash or fish

"
`;

