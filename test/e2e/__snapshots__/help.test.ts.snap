  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)

"
`;

