// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`help kit --help 1`] = `
"kit

Usage
  kit <command> [options]

Develop
  dev         Run a dev server
  build       Build every target
  deploy      Deploy a target
  gradle      Run ./gradlew in the Gradle root
  wrangler    Run wrangler in a worker target's directory
  xcode       Open the iOS project in Xcode

Quality
  lint        Lint every target
  format      Format every target
  typecheck   Typecheck every target
  check       Lint and typecheck every target
  test        Run the test suites

Release
  release     Ship to the stores …

Infra
  env         Render, check and push env from .env …
  db          Cloudflare D1 migrations and queries …

Setup
  doctor      Check tools, versions and .env
  init        Set up a fresh clone
  deps        List or update npm dependencies (catalog-aware)
  config      Print the resolved kit.config.ts
  completion  Print a shell completion script

"
`;

exports[`help kit db --help 1`] = `
"Cloudflare D1 migrations and queries

Usage
  kit db <command> [options]

Commands
  migrate  Apply pending D1 migrations
  list     List D1 migrations
  create   Create a D1 migration
  exec     Run SQL against D1

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit env --help 1`] = `
"Render, check and push env from .env

Usage
  kit env <command> [options]

Commands
  sync   Render env outputs (.dev.vars) from .env
  check  Validate .env and check outputs for drift
  push   Push secrets with wrangler and gh
  init   Create .env and ask for missing keys

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit release --help 1`] = `
"Ship to the stores

Usage
  kit release <command> [options]

Commands
  ios      Build and upload iOS to a track
  android  Build and upload Android to a track

Options
  -h, --help     Show help
  -V, --version  Show kit version

"
`;

exports[`help kit build --help 1`] = `
"Build every target

Usage
  kit build [options]

Examples
  kit build
  kit build api admin
  kit build client --release

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
      --release  Gradle: the signed release bundle (AAB)
      --apk      Gradle: the signed release APK

"
`;

exports[`help kit check --help 1`] = `
"Lint and typecheck every target

Usage
  kit check [options]

Examples
  kit check
  kit check api admin web
  kit check --fix

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
  -f, --fix      Format instead of lint, then typecheck

"
`;

exports[`help kit completion --help 1`] = `
"Print a shell completion script

Usage
  kit completion <shell> [options]

Examples
  # zsh: add to ~/.zshrc (after compinit)
  source <(kit completion zsh)
  # bash: add to ~/.bashrc
  source <(kit completion bash)
  # fish
  kit completion fish > ~/.config/fish/completions/kit.fish

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
  <shell>        zsh, bash or fish

"
`;

