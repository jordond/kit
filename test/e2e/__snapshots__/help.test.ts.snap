exports[`help kit shots --help 2`] = `
"Capture screenshots with the Maestro flows: 9:41 status bar, fixture, PNGs

Usage
  kit shots <command> [options]

Examples
  kit shots android
  kit shots ios --full
  kit shots ipad --no-build --out brand/screenshots/ipad
  kit shots android --dry-run --json

Commands
  export  Render the store screenshots from the raw shots and the saved project

Options
  -h, --help              Show help
  -V, --version           Show kit version
      --json              Write one JSON document to stdout; no prompts or animation
  -n, --dry-run           Plan and run read-only steps; skip mutations
  -y, --yes               Accept confirmations (never skips prod)
  -v, --verbose           Stream all child output
  -q, --quiet             Errors and summary only
      --bail              Stop at the first failure
      --suite <string>    Run this maestro.suites entry
      --device <string>   Simulator UDID or adb serial (default: the running one)
      --no-build          Install the newest existing build
      --fixture <string>  Load this fixture instead of the suite's
      --no-fixture        Load no fixture
      --full              Run the shots-full suite (define it under maestro.suites)
      --out <string>      Copy the screenshots here instead of the suite dir (used as is)

"
`;

exports[`help kit shots export --help 1`] = `
"Render the store screenshots from the raw shots and the saved project

Usage
  kit shots export [options]

Examples
  kit shots export
  kit shots export --store apple --locale en-US
  kit shots export --out build/store-shots --dry-run --json

Options
  -h, --help             Show help
  -V, --version          Show kit version
      --json             Write one JSON document to stdout; no prompts or animation
  -n, --dry-run          Plan and run read-only steps; skip mutations
  -y, --yes              Accept confirmations (never skips prod)
  -v, --verbose          Stream all child output
  -q, --quiet            Errors and summary only
      --bail             Stop at the first failure
      --store <string>   apple, google or both (default both)
      --locale <string>  Only these locales, comma-separated (en-US,fr-FR)
      --out <string>     Write under <dir>/apple and <dir>/google instead of the store listing dirs
      --allow-missing    Skip slides whose raw shot is absent
      --force            Replace images in a set that kit did not write

"
`;

exports[`help kit test --help 1`] = `
"Run the test suites

Usage
  kit test [options]

Examples
  kit test
  kit test api
  kit test client -- --rerun
  kit test --affected --base origin/develop

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)

"
`;

exports[`help kit typecheck --help 1`] = `
"Typecheck every target

Usage
  kit typecheck [options]

Examples
  kit typecheck

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)

"
`;

exports[`help kit upgrade --help 1`] = `
"Move the @jordond/kit pin and the workflow SHAs to a kit release

Usage
  kit upgrade [options]

Examples
  kit upgrade           # the latest release on npm
  kit upgrade 0.6.0
  kit upgrade --dry-run

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;

exports[`help kit version bump --help 1`] = `
"Bump a version name in the catalog TOML, commit, and push

Usage
  kit version bump [options]

Examples
  kit version bump patch
  kit version bump minor --platform ios
  kit version bump patch --platform api --no-push
  kit version bump minor --pr

Options
  -h, --help               Show help
  -V, --version            Show kit version
      --json               Write one JSON document to stdout; no prompts or animation
  -n, --dry-run            Plan and run read-only steps; skip mutations
  -y, --yes                Accept confirmations (never skips prod)
  -v, --verbose            Stream all child output
  -q, --quiet              Errors and summary only
      --bail               Stop at the first failure
  -p, --platform <string>  ios | android | all (ios + android) | a service key from versions.keys
      --no-push            Commit only; do not push
      --pr                 Commit on a new branch, push it and open a PR (gh)

"
`;

exports[`help kit version show --help 1`] = `
"Show version names (from the catalog TOML) and the last release tags

Usage
