exports[`help kit upgrade --help 1`] = `
"Move the @jordond/kit pin and the workflow SHAs to a kit release

Usage
  kit upgrade [options]

Examples
  kit upgrade           # the latest release on npm
  kit upgrade 0.6.0
  kit upgrade --dry-run

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;

exports[`help kit version bump --help 1`] = `
"Bump a version name in the catalog TOML, commit, and push

Usage
  kit version bump [options]

Examples
  kit version bump patch
  kit version bump minor --platform ios
  kit version bump patch --platform api --no-push
  kit version bump minor --pr

Options
  -h, --help               Show help
  -V, --version            Show kit version
      --json               Write one JSON document to stdout; no prompts or animation
  -n, --dry-run            Plan and run read-only steps; skip mutations
  -y, --yes                Accept confirmations (never skips prod)
  -v, --verbose            Stream all child output
  -q, --quiet              Errors and summary only
      --bail               Stop at the first failure
  -p, --platform <string>  ios | android | all (ios + android) | a service key from versions.keys
      --no-push            Commit only; do not push
      --pr                 Commit on a new branch, push it and open a PR (gh)

"
`;

exports[`help kit version show --help 1`] = `
"Show version names (from the catalog TOML) and the last release tags

Usage
  kit version show [options]

Examples
  kit version show
  kit version show ios
  kit version show --json

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;

exports[`help kit wrangler --help 1`] = `
"Run wrangler in a worker target's directory (arguments pass through)

Usage
  kit wrangler [args…]

Every argument passes through untouched; kit parses no flags here (no --json).
Only a leading -h/--help shows this; \`kit wrangler <args> --help\` reaches the tool.

Examples
  kit wrangler api whoami
  kit wrangler api d1 list
  kit wrangler api deploy --dry-run

"
`;

exports[`help kit xcode --help 1`] = `
"Open the iOS project in Xcode

Usage
  kit xcode [options]

Examples
  kit xcode
  kit xcode --dry-run --json

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;
