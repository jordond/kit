exports[`help kit db backup --help 1`] = `
"Export a D1 database to a .sql file (local by default)

Usage
  kit db backup [options]

Examples
  kit db backup                       # backups/<db>-20260102T030405Z.sql
  kit db backup --remote --db analytics
  kit db backup --remote --out prod.sql

Options
  -h, --help          Show help
  -V, --version       Show kit version
      --json          Write one JSON document to stdout; no prompts or animation
  -n, --dry-run       Plan and run read-only steps; skip mutations
  -y, --yes           Accept confirmations (never skips prod)
  -v, --verbose       Stream all child output
  -q, --quiet         Errors and summary only
      --bail          Stop at the first failure
      --db <string>   cloudflare.d1 key or database name (default: the only one, or the default: true one)
      --remote        Deployed D1 (default: local)
  -o, --out <string>  File to write (default: backups/<db>-<UTC timestamp>.sql)

"
`;

exports[`help kit db create --help 1`] = `
"Create a new D1 migration file

Usage
  kit db create [options]

Examples
  kit db create add_widgets
  kit db create add_events --db analytics

Options
  -h, --help         Show help
  -V, --version      Show kit version
      --json         Write one JSON document to stdout; no prompts or animation
  -n, --dry-run      Plan and run read-only steps; skip mutations
  -y, --yes          Accept confirmations (never skips prod)
  -v, --verbose      Stream all child output
  -q, --quiet        Errors and summary only
      --bail         Stop at the first failure
      --db <string>  cloudflare.d1 key or database name (default: the only one, or the default: true one)

"
`;

exports[`help kit db exec --help 1`] = `
"Run SQL against a D1 database (local by default)

Usage
  kit db exec [options]

Examples
  kit db exec "SELECT count(*) FROM users"
  kit db exec --remote "SELECT 1" --json
  kit db exec --file seed.sql

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --db <string>    cloudflare.d1 key or database name (default: the only one, or the default: true one)
      --remote         Deployed D1 (default: local)
  -f, --file <string>  Run a .sql file instead of a statement

"
`;

exports[`help kit db list --help 1`] = `
"List applied and pending D1 migrations

Usage
  kit db list [options]

Examples
  kit db list
  kit db list --remote --db analytics

Options
  -h, --help         Show help
  -V, --version      Show kit version
      --json         Write one JSON document to stdout; no prompts or animation
