exports[`help kit init --help 1`] = `
"Set up a fresh clone, or a new repo: .env, install, env sync, wrangler types, native deps

Usage
  kit init [options]

Examples
  kit init
  kit init --dry-run
  kit init --yes       # also scaffold mise.toml and lefthook.yml
  kit init --js-only   # JS workspace only: no Gradle, no bundle install
  kit init --template toolchain   # add kit to a Kotlin toolchain project (kit goes in .kit/)
  kit init --template gradle --name MyApp

Options
  -h, --help               Show help
  -V, --version            Show kit version
      --json               Write one JSON document to stdout; no prompts or animation
  -n, --dry-run            Plan and run read-only steps; skip mutations
  -y, --yes                Accept confirmations (never skips prod)
  -v, --verbose            Stream all child output
  -q, --quiet              Errors and summary only
      --bail               Stop at the first failure
      --js-only            Skip the Gradle, Kotlin toolchain and bundler steps
      --template <string>  New repo: write the kit files first (toolchain: an existing Kotlin toolchain project; gradle)
      --name <string>      App name for --template (default: the directory name)

"
`;

