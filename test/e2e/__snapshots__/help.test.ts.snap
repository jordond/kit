  -v, --verbose          Stream all child output
  -q, --quiet            Errors and summary only
      --bail             Stop at the first failure
  -t, --target <string>  Only this worker target (env.workerSecrets)
      --github           Push env.githubSecrets with gh
      --all              Every worker and GitHub; the default, kept for scripts
      --workers          Every worker in env.workerSecrets; GitHub skipped

"
`;

