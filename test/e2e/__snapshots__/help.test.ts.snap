  -h, --help         Show help
  -V, --version      Show kit version
      --json         Write one JSON document to stdout; no prompts or animation
  -n, --dry-run      Plan and run read-only steps; skip mutations
  -y, --yes          Accept confirmations (never skips prod)
  -v, --verbose      Stream all child output
  -q, --quiet        Errors and summary only
      --bail         Stop at the first failure
      --db <string>  cloudflare.d1 key or database name (default: the only one, or the default: true one)
      --remote       Deployed D1 (default: local)

"
`;

exports[`help kit db migrate --help 1`] = `
"Apply pending D1 migrations (local by default)

Usage
  kit db migrate [options]

Examples
  kit db migrate                 # the only database, or the default: true one
  kit db migrate --remote
  kit db migrate --db analytics --dry-run

Options
  -h, --help         Show help
  -V, --version      Show kit version
      --json         Write one JSON document to stdout; no prompts or animation
  -n, --dry-run      Plan and run read-only steps; skip mutations
  -y, --yes          Accept confirmations (never skips prod)
  -v, --verbose      Stream all child output
  -q, --quiet        Errors and summary only
      --bail         Stop at the first failure
      --db <string>  cloudflare.d1 key or database name (default: the only one, or the default: true one)
      --remote       Deployed D1 (default: local)

"
`;

exports[`help kit deploy --help 1`] = `
"Deploy one or more targets, in order (deploy.before first)

Usage
  kit deploy [options]

Examples
  kit deploy api
  kit deploy api admin web          # in order; stops at the first failure
  kit deploy web --env staging
  kit deploy api web --env staging  # the env goes to the targets that declare it
  kit deploy api --dry-run --json

Options
  -h, --help          Show help
  -V, --version       Show kit version
      --json          Write one JSON document to stdout; no prompts or animation
  -n, --dry-run       Plan and run read-only steps; skip mutations
  -y, --yes           Accept confirmations (never skips prod)
  -v, --verbose       Stream all child output
  -q, --quiet         Errors and summary only
      --bail          Stop at the first failure
  -e, --env <string>  Environment, for targets that declare envs

"
`;

exports[`help kit deps --help 1`] = `
"List or update npm dependencies across the workspace (catalog-aware)

Usage
  kit deps [options]

Examples
  kit deps                     # list everything with a newer version
  kit deps update              # newest versions the declared ranges allow (bun.lock only)
  kit deps latest wrangler     # rewrite ranges to latest (catalog entry first), then install

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;

exports[`help kit dev --help 1`] = `
"Run dev servers: one target, several, or every target with a dev command (Ctrl-C stops all)

Usage
  kit dev [options]

Examples
  kit dev                  # workspace.dev and every target with a dev command, together
  kit dev api              # one dev server, attached to the terminal
  kit dev api admin        # several, output prefixed by target
  kit dev web --env staging
  kit dev --dry-run --json

Options
  -h, --help          Show help
  -V, --version       Show kit version
      --json          Write one JSON document to stdout; no prompts or animation
  -n, --dry-run       Plan and run read-only steps; skip mutations
  -y, --yes           Accept confirmations (never skips prod)
  -v, --verbose       Stream all child output
  -q, --quiet         Errors and summary only
      --bail          Stop at the first failure
  -e, --env <string>  Environment, for targets that declare envs

"
`;

exports[`help kit doctor --help 1`] = `
"Check tools, versions and .env

Usage
  kit doctor [options]

Examples
  kit doctor
  kit doctor --json
  kit doctor --ci

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
      --ci       Fail when CI workflow pins drift from the package.json pin

"
`;

exports[`help kit env check --help 1`] = `
"Validate .env, check outputs for drift, and check GitHub has every CI secret

Usage
  kit env check [options]

Examples
  kit env check
  kit env check --schema-only
  kit env check --json

Options
  -h, --help         Show help
  -V, --version      Show kit version
      --json         Write one JSON document to stdout; no prompts or animation
  -n, --dry-run      Plan and run read-only steps; skip mutations
  -y, --yes          Accept confirmations (never skips prod)
  -v, --verbose      Stream all child output
  -q, --quiet        Errors and summary only
      --bail         Stop at the first failure
      --schema-only  Validate .env only; skip output drift and GitHub secrets (CI)

"
`;

exports[`help kit env init --help 1`] = `
"Create .env from .env.example and ask for missing required keys

Usage
  kit env init [options]

Examples
  kit env init
  kit env init --dry-run

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;

exports[`help kit env push --help 1`] = `
"Push secrets to Cloudflare workers (wrangler) and GitHub Actions (gh)

Usage
  kit env push [options]

Examples
  kit env push                    # every worker in env.workerSecrets and env.githubSecrets
  kit env push --target edge
  kit env push --github           # GitHub Actions secrets only
  kit env push --target edge --github
  kit env push --yes              # everything, no prompt (CI)
  kit env push --dry-run

Options
  -h, --help             Show help
  -V, --version          Show kit version
      --json             Write one JSON document to stdout; no prompts or animation
  -n, --dry-run          Plan and run read-only steps; skip mutations
  -y, --yes              Accept confirmations (never skips prod)
  -v, --verbose          Stream all child output
  -q, --quiet            Errors and summary only
      --bail             Stop at the first failure
  -t, --target <string>  Only this worker target (env.workerSecrets)
      --github           Push env.githubSecrets with gh
      --all              Every worker and GitHub; the default, kept for scripts

"
`;

exports[`help kit env sync --help 1`] = `
"Render env outputs (.dev.vars) from .env

Usage
  kit env sync [options]

Examples
  kit env sync
  kit env sync --dry-run
  kit env sync --json

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure

"
`;

exports[`help kit fastlane --help 1`] = `
"Run fastlane with kit's shared Fastfile and Gemfile (arguments pass through)

Usage
  kit fastlane [args…]

Every argument passes through untouched; kit parses no flags here (no --json).
Only a leading -h/--help shows this; \`kit fastlane <args> --help\` reaches the tool.

Examples
  kit fastlane lanes
  kit fastlane ios next_build
  kit fastlane run sentry_check_cli_installed

"
`;

exports[`help kit format --help 1`] = `
"Format every target

Usage
  kit format [options]

Examples
  kit format
  kit format client
  kit format --check

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)
      --check          Check only (runs each target's lint command)
      --staged         Only targets with staged files; workspace commands get the files

"
`;

exports[`help kit gradle --help 1`] = `
"Run ./gradlew in the Gradle root (arguments pass through)

Usage
  kit gradle [args…]

Every argument passes through untouched; kit parses no flags here (no --json).
Only a leading -h/--help shows this; \`kit gradle <args> --help\` reaches the tool.

Examples
  kit gradle assembleDebug
  kit gradle :shared:test --info
  kit gradle help --task assembleDebug

"
`;

exports[`help kit init --help 1`] = `
"Set up a fresh clone, or a new repo: .env, install, env sync, wrangler types, native deps

Usage
  kit init [options]

Examples
  kit init
  kit init --dry-run
  kit init --yes       # also scaffold mise.toml and lefthook.yml
  kit init --js-only   # JS workspace only: no Gradle, no bundle install
  kit init --template toolchain   # add kit to a Kotlin toolchain project (kit goes in .kit/)
  kit init --template gradle --name MyApp

Options
  -h, --help               Show help
  -V, --version            Show kit version
      --json               Write one JSON document to stdout; no prompts or animation
  -n, --dry-run            Plan and run read-only steps; skip mutations
  -y, --yes                Accept confirmations (never skips prod)
  -v, --verbose            Stream all child output
  -q, --quiet              Errors and summary only
      --bail               Stop at the first failure
      --js-only            Skip the Gradle, Kotlin toolchain and bundler steps
      --template <string>  New repo: write the kit files first (toolchain: an existing Kotlin toolchain project; gradle)
      --name <string>      App name for --template (default: the directory name)

"
`;

exports[`help kit kotlin --help 1`] = `
"Run the Kotlin toolchain wrapper in toolchain.root (arguments pass through)

Usage
  kit kotlin [args…]

Every argument passes through untouched; kit parses no flags here (no --json).
Only a leading -h/--help shows this; \`kit kotlin <args> --help\` reaches the tool.

Examples
  kit kotlin build -m shared
  kit kotlin run -m desktopApp
  kit kotlin show settings -m androidApp

"
`;

exports[`help kit lint --help 1`] = `
"Lint every target

Usage
  kit lint [options]

Examples
  kit lint
  kit lint api web
  kit lint --staged --fix

Options
  -h, --help           Show help
  -V, --version        Show kit version
      --json           Write one JSON document to stdout; no prompts or animation
  -n, --dry-run        Plan and run read-only steps; skip mutations
  -y, --yes            Accept confirmations (never skips prod)
  -v, --verbose        Stream all child output
  -q, --quiet          Errors and summary only
      --bail           Stop at the first failure
      --affected       Only targets changed since the base (commits, staged, unstaged and untracked files)
      --base <string>  Ref --affected compares against (default: origin/<default branch>, then main)
  -f, --fix            Apply fixes (runs each target's format command)
      --staged         Only targets with staged files; workspace commands get the files

"
`;

exports[`help kit release android --help 1`] = `
"Build and upload Android to a Play track

Usage
  kit release android [options]

Examples
  kit release android --track internal
  kit release android --track prod --rollout 0.2
  kit release android --track alpha --draft
  kit release android --track internal --dry-run

Options
  -h, --help              Show help
  -V, --version           Show kit version
      --json              Write one JSON document to stdout; no prompts or animation
  -n, --dry-run           Plan and run read-only steps; skip mutations
  -y, --yes               Accept confirmations (never skips prod)
  -v, --verbose           Stream all child output
  -q, --quiet             Errors and summary only
      --bail              Stop at the first failure
  -t, --track <enum>      Play internal testing · closed (alpha) · open (beta) · production (prod)
      --code <number>     Version code (default: max across Play tracks + 1)
      --notes <string>    Release notes (default: commits since the last android/v* tag; clamped to 500)
      --rollout <number>  prod staged-rollout fraction, 0 < r <= 1 (default release.android.prodRollout or 0.1)
      --draft             Upload as a draft release (required while the Play app is a draft)
      --skip <string>     Skip release.preflight checks by skipFlag (comma-separated)

"
`;

exports[`help kit release certs --help 1`] = `
"Install App Store signing with match (readonly); --add creates what is missing

Usage
  kit release certs [options]

Examples
  kit release certs
  kit release certs --add

Options
  -h, --help     Show help
  -V, --version  Show kit version
      --json     Write one JSON document to stdout; no prompts or animation
  -n, --dry-run  Plan and run read-only steps; skip mutations
  -y, --yes      Accept confirmations (never skips prod)
  -v, --verbose  Stream all child output
  -q, --quiet    Errors and summary only
      --bail     Stop at the first failure
      --add      Create missing certificates/profiles for this app's bundle ids and team only (never nuke)

"
`;

exports[`help kit release ios --help 1`] = `
"Build and upload iOS to a track

Usage
  kit release ios [options]

Examples
  kit release ios --track internal
  kit release ios --track beta --yes
  kit release ios --track prod --notes "Bug fixes"
  kit release ios --track internal --dry-run

Options
  -h, --help            Show help
  -V, --version         Show kit version
      --json            Write one JSON document to stdout; no prompts or animation
  -n, --dry-run         Plan and run read-only steps; skip mutations
  -y, --yes             Accept confirmations (never skips prod)
  -v, --verbose         Stream all child output
  -q, --quiet           Errors and summary only
      --bail            Stop at the first failure
  -t, --track <enum>    internal: TestFlight internal · alpha/beta: TestFlight group · prod: App Store
      --build <number>  Build number (default: max in App Store Connect + 1)
      --notes <string>  Release notes (default: commits since the last ios/v* tag); prod: What's New, required
      --skip <string>   Skip release.preflight checks by skipFlag (comma-separated)

"
`;

exports[`help kit test --help 1`] = `
