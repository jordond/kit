# Every key this repo reads. `kit init` copies this to .env (gitignored, owner-only); fill in the
# values there. `kit doctor` reports keys .env is missing. Never commit values here.

# App Store Connect API key (kit release ios)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_P8_BASE64=

# match signing (kit release ios, kit release certs)
MATCH_PASSWORD=
MATCH_GIT_URL=
MATCH_GIT_BASIC_AUTHORIZATION=

# Android upload key (kit release android, local release builds)
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=

# Play service account (kit release android)
PLAY_SERVICE_ACCOUNT_BASE64=
